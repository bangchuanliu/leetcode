#!/usr/bin/env bash
# Compile and run a single solution file, without building the whole project.
#
#   scripts/jrun FileName                 # compiles FileName.java and runs its main(String[])
#   scripts/jrun FileName methodName      # compiles FileName.java and calls methodName() on it
#   scripts/jrun FileName methodName a b  # ...passing a, b as the method's arguments
#
# Array arguments are comma-separated, e.g.:
#   scripts/jrun CoinChange coinChange 1,2,5 11
#
# Looks for FileName.java under leetcode/, company-interviews/ and every
# module under courses-and-books/ (each one's src/main/java). If the same
# file name exists in more than one place, disambiguate with a path suffix
# instead of just the file name, e.g.:
#   scripts/jrun leetcode/dp/CoinChange coinChange 1,2,5 11
set -euo pipefail

if [ "$#" -lt 1 ]; then
  echo "Usage: jrun <FileName> [methodName] [args...]" >&2
  exit 1
fi

FILE_NAME="$1"
shift

OUT_DIR="scripts/target/jrun"

cd "$(dirname "$0")/.."

SRC_ROOTS=("leetcode/src/main/java" "company-interviews/src/main/java")
for d in courses-and-books/*/src/main/java; do
  [ -d "$d" ] && SRC_ROOTS+=("$d")
done

MATCHES=()
if [[ "$FILE_NAME" == */* ]]; then
  REL="${FILE_NAME%.java}.java"
  for root in "${SRC_ROOTS[@]}"; do
    while IFS= read -r f; do
      MATCHES+=("$root|$f")
    done < <(find "$root" -path "*/${REL}")
  done
  FILE_NAME="$(basename "$REL" .java)"
else
  for root in "${SRC_ROOTS[@]}"; do
    while IFS= read -r f; do
      MATCHES+=("$root|$f")
    done < <(find "$root" -name "${FILE_NAME}.java")
  done
fi

if [ "${#MATCHES[@]}" -eq 0 ]; then
  echo "No file named ${FILE_NAME}.java found under: ${SRC_ROOTS[*]}" >&2
  exit 1
fi
if [ "${#MATCHES[@]}" -gt 1 ]; then
  echo "Multiple files named ${FILE_NAME}.java found, pick one:" >&2
  for m in "${MATCHES[@]}"; do echo "  ${m#*|}" >&2; done
  exit 1
fi

SRC_ROOT="${MATCHES[0]%%|*}"
MATCH="${MATCHES[0]#*|}"

PACKAGE=$(grep -m1 '^package ' "$MATCH" | sed 's/package //; s/;//')
CLASS_NAME="${PACKAGE}.${FILE_NAME}"

mkdir -p "$OUT_DIR"
javac -d "$OUT_DIR" -sourcepath "$SRC_ROOT" "$MATCH" scripts/tools/JRunner.java

# Put the module's resources (data files loaded via getResource) on the classpath too.
CLASSPATH_ARG="$OUT_DIR"
RES_DIR="${SRC_ROOT%/java}/resources"
[ -d "$RES_DIR" ] && CLASSPATH_ARG="$CLASSPATH_ARG:$RES_DIR"

java -cp "$CLASSPATH_ARG" JRunner "$CLASS_NAME" "$@"
